# SCUD Configuration
# Copy this file to .env and customize as needed

# Default LLM provider: xai, anthropic, openai, openrouter, claude-cli, codex
SCUD_PROVIDER=xai

# Default model for the provider
SCUD_MODEL=xai/grok-code-fast-1

# Smart tier (for validation/analysis - large context tasks)
SCUD_SMART_PROVIDER=claude-cli
SCUD_SMART_MODEL=opus

# Fast tier (for generation tasks)
SCUD_FAST_PROVIDER=xai
SCUD_FAST_MODEL=xai/grok-code-fast-1

# Max tokens for LLM requests
SCUD_MAX_TOKENS=16000

# API Keys (only needed for providers you use)
# XAI_API_KEY=xai-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
