{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash -c 'scud sync-from-claude 2>/dev/null || true'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "TaskUpdate|TaskCreate"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash -c 'if [ -n \"$SCUD_TASK_ID\" ]; then scud set-status \"$SCUD_TASK_ID\" done 2>/dev/null || true; fi'",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}