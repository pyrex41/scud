// Branching pipeline: plan → implement → validate → gate → exit or loop
digraph branching {
    graph [goal="Plan, implement, and validate a feature"]

    start [shape=Mdiamond, label="Start"]

    plan [shape=box, label="Plan Implementation"
        prompt="Create a detailed implementation plan for: $goal"
        reasoning_effort="high"]

    implement [shape=box, label="Write Code"
        prompt="Implement the plan from the planning phase. Write clean, tested code."
        max_retries=2]

    validate [shape=parallelogram, label="Run Validation"
        tool_command="cargo build && cargo test 2>&1"]

    gate [shape=diamond, label="Check Results"]

    finish [shape=Msquare, label="Done", goal_gate=true, retry_target="implement"]

    start -> plan -> implement -> validate -> gate
    gate -> finish [label="success", condition="outcome=success"]
    gate -> implement [label="retry", condition="outcome=failure"]
}
