// Parallel pipeline: fan-out to 3 approaches, fan-in selects best
digraph parallel {
    graph [goal="Try multiple approaches and select the best one"]

    start [shape=Mdiamond]

    fan_out [shape=component, label="Fan Out"]

    approach_a [shape=box, label="Approach A"
        prompt="Implement $goal using approach A: functional style with immutable data."
        class="fast"]

    approach_b [shape=box, label="Approach B"
        prompt="Implement $goal using approach B: object-oriented with design patterns."
        class="fast"]

    approach_c [shape=box, label="Approach C"
        prompt="Implement $goal using approach C: simple procedural implementation."
        class="fast"]

    fan_in [shape=tripleoctagon, label="Select Best"]

    finish [shape=Msquare, label="Done"]

    start -> fan_out
    fan_out -> approach_a
    fan_out -> approach_b
    fan_out -> approach_c
    approach_a -> fan_in
    approach_b -> fan_in
    approach_c -> fan_in
    fan_in -> finish
}
