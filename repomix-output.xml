            .spawn("task-1", "cmd", "/p", TerminalType::Tmux)
            .unwrap();

        // Initially running
        let session = manager.get_session(&session_id).unwrap();
        assert_eq!(session.status, SessionStatus::Running);

        // Update to completed
        manager.complete_session(&session_id, Some("Done!".to_string())).unwrap();
        let session = manager.get_session(&session_id).unwrap();
