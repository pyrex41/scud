    "SessionStart": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "scud claim ${TASK_ID} --pid ${CLAUDE_SESSION_ID} --wave ui-overhaul-2025-11",
            "run_in_background": true
