#[test]
fn test_us2_next_respects_dependencies() {
    let project = TestProject::simple_project();
    let mut phase = project.storage.load_active_group().unwrap();

    // Mark task 1 as done
    phase.get_task_mut("1").unwrap().set_status(scud::models::TaskStatus::Done);
